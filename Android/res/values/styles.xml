<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Schermo intero, senza barra del titolo; lo sfondo è il blu del mare finché il gioco non disegna. -->
    <style name="Theme.Marea" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sea</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/sea</item>
        <item name="android:navigationBarColor">@color/sea</item>
    </style>
    <color name="sea">#0B2E57</color>
</resources>
