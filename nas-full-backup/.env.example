# Copia questo file in .env e compila i valori.

# Indirizzi dell'iPhone, separati da virgola, provati in ordine:
# prima l'IP in casa (meglio se fisso, impostato nel router), poi l'IP Tailscale dell'iPhone (100.x.y.z).
IPHONE_HOSTS=192.168.1.50,100.101.102.103

# Password di cifratura dei backup (usata solo dal comando encryption-on).
# SENZA QUESTA PASSWORD IL BACKUP NON SI PUÒ RIPRISTINARE: conservala in un gestore di password.
BACKUP_PASSWORD=

# Ogni quante ore fare il backup e dopo quanti minuti riprovare se l'iPhone non risponde.
INTERVAL_HOURS=24
RETRY_MINUTES=30

# Facoltativo: notifica a fine backup (es. un topic ntfy: https://ntfy.sh/un-nome-difficile-da-indovinare)
NOTIFY_URL=

# Percorsi dentro il container (di solito non vanno cambiati)
PAIRING_FILE=/config/pairing.plist
BACKUP_DIR=/backups
