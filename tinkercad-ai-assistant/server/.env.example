# Copia questo file in .env e inserisci i tuoi valori.
# Il file .env è escluso da git: non condividerlo e non incollare la chiave nell'estensione.

# Obbligatorio: chiave API di OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Obbligatorio: slug del modello OpenRouter, ad esempio "fornitore/nome-modello".
# Scegli un modello che accetti immagini in input (colonna "Input" = image su https://openrouter.ai/models).
OPENROUTER_MODEL=

# --- Opzionali ---------------------------------------------------------------

# Modelli di riserva, separati da virgola: OpenRouter li prova in ordine se il modello principale
# è sovraccarico, limitato o non disponibile. Scegli modelli che accettano immagini.
# Per restare gratis usa solo modelli ":free" (un modello a pagamento in lista verrebbe addebitato).
# OPENROUTER_FALLBACK_MODELS=

# Indirizzo e porta del server (lascia 127.0.0.1 per renderlo raggiungibile solo dal tuo computer)
# HOST=127.0.0.1
# PORT=3000

# Timeout della chiamata a OpenRouter in millisecondi (default 90000)
# OPENROUTER_TIMEOUT_MS=90000

# Numero massimo di token generati (default 8000)
# OPENROUTER_MAX_TOKENS=8000

# Temperatura (non impostata = default del modello)
# OPENROUTER_TEMPERATURE=0.2

# Dimensione massima del corpo della richiesta in MB (default 8)
# MAX_BODY_MB=8

# Richieste al minuto consentite verso /api/generate (default 10)
# RATE_LIMIT_PER_MIN=10

# ID dell'estensione autorizzati, separati da virgola (vedi chrome://extensions).
# Vuoto = qualsiasi origine chrome-extension:// è accettata.
# ALLOWED_EXTENSION_IDS=

# Token condiviso facoltativo: se impostato, va inserito anche nel popup dell'estensione.
# Non è la chiave OpenRouter: serve solo a impedire l'uso del server da parte di altri.
# ACCESS_TOKEN=

# Header facoltativi di attribuzione per OpenRouter
# APP_URL=
# APP_TITLE=Tinkercad AI Code Assistant
