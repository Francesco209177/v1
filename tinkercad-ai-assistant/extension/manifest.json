{
  "manifest_version": 3,
  "name": "Tinkercad AI Code Assistant",
  "short_name": "TC AI Code",
  "version": "1.0.0",
  "description": "Genera codice Arduino per Tinkercad Circuits da uno screenshot del circuito e da una richiesta, tramite OpenRouter.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.tinkercad.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tinkercad AI Code Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Apri o chiudi l'assistente AI (autorizza anche lo screenshot della scheda)"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.tinkercad.com/*"],
      "js": ["shared/hotkeys.js", "content/hotkeys.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.tinkercad.com/*"],
      "js": ["content/page-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tinkercad.com/*"],
      "js": [
        "shared/state-machine.js",
        "shared/extract-code.js",
        "content/tinkercad-dom.js",
        "content/ui.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/panel.css"],
      "matches": ["https://www.tinkercad.com/*"]
    }
  ]
}
